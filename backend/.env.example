# Application Port
PORT=5000

# Client URL for CORS & Socket.IO
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gas_monitoring_db
